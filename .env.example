# ── Supabase (required) ────────────────────────────────────────────
# Project Settings → API. The publishable/anon key is safe in client
# code — Row Level Security is the actual authorisation boundary.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ── Crypto ─────────────────────────────────────────────────────────
# Nothing to set. CoinGecko's public API needs no key, so BTC/ETH/SOL
# quotes, candles, signals and forecasts all work out of the box.

# ── Equity quotes (optional) ───────────────────────────────────────
# Finnhub free tier: 60 req/min — the best free source for live equity
# quotes. NOTE: its /stock/candle endpoint is premium-only; a free key
# returns 403 "You don't have access to this resource". So this key
# alone gives prices but NO history, which means no signals and no
# forecasts on stocks. Pair it with Twelve Data below.
# https://finnhub.io/register
FINNHUB_API_KEY=

# ── Equity history (needed for stock signals + forecasts) ──────────
# Twelve Data free tier: 800 credits/day, 8 req/min. This is what makes
# the indicator and forecast engines run on equities instead of crypto
# only. Without it the app reports equity history as unavailable rather
# than inventing bars.
# https://twelvedata.com/pricing
TWELVEDATA_API_KEY=

# Alpha Vantage free tier: 25 req/day, 5 req/min, daily bars only.
# Fallback for when the Twelve Data daily budget is exhausted — too
# thin to serve as a primary source.
# https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# ── Macro series (optional) ────────────────────────────────────────
# FRED (St. Louis Fed). Free, instant, effectively unlimited. Powers
# the macro panel: yield curve, CPI, unemployment, policy rate.
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── Multi-agent debate (optional) ──────────────────────────────────
# OpenRouter routes to free-tier LLMs for the analyst/researcher/trader/
# risk-manager debate. Without it the Agents view degrades to the
# deterministic composite signal instead of inventing opinions.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
