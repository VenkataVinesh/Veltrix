# ── Supabase (required) ────────────────────────────────────────────
# Project Settings → API. The publishable/anon key is safe in client
# code — Row Level Security is the actual authorisation boundary.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ── Equities (optional) ────────────────────────────────────────────
# Crypto works with no key at all (CoinGecko). Set this to switch on
# equity prices and candles via Finnhub. Without it, the Markets screen
# says so explicitly instead of showing invented numbers.
FINNHUB_API_KEY=
