# Frontend configuration for local development
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/api/v1/stream

# Optional: enables the "Try Demo Account" button on the login page.
# Must match the seeded demo account password (SEED_DEMO_PASSWORD in backend/.env).
NEXT_PUBLIC_DEV_LOGIN_EMAIL=demo@veltrix.ai
NEXT_PUBLIC_DEV_LOGIN_PASSWORD=
